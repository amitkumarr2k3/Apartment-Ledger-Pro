# Copy to .env before `docker compose up`. Defaults work for local demo.
# Host ports (published on your machine): web 8090, api 4010, postgres 5442,

# Copy this to .env (which must stay out of git) and fill in real values.
# Generate JWT_SECRET yourself on your server -- do NOT paste a secret into
# a chat/AI tool, since that value would live in the transcript forever.
#   openssl rand -hex 32
JWT_SECRET=dev-jwt-secret-change-me

# Comma-separated list of exact origins allowed to call the API with
# credentials (cookies). Must match your real domain(s) once you're on HTTPS.
CORS_ORIGIN=

# Set to "true" ONLY once you are actually serving over HTTPS. Leave "false"
# (or unset) while testing over plain HTTP/bare-IP -- otherwise the browser
# silently drops the auth cookie and every request 401s.
COOKIE_SECURE=false


# mailhog SMTP 1035, mailhog UI 8035. Container-internal ports are unchanged.
DATABASE_URL=postgres://apf:apf@db:5432/apartment_finance
SUPERADMIN_EMAIL=admin@example.com
# Email provider: gmail (default), resend, or mailhog
EMAIL_PROVIDER=gmail

# Gmail settings (required when EMAIL_PROVIDER=gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_16_char_app_password
FROM_EMAIL=yourgmail@gmail.com
APP_NAME=CG Boulevard Treasurer

# Resend settings (used when EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_xxx

# MailHog fallback (used when EMAIL_PROVIDER=mailhog)
# SMTP_HOST=mailhog
# SMTP_PORT=1025
APP_URL=http://localhost:8090

# ── HTTPS (production only) ────────────────────────────────────────────────────
# Set DOMAIN to your public domain name AFTER you have obtained a Let's Encrypt
# certificate (see DEPLOY-VM.md Part 10).  Leave blank for HTTP-only local dev.
# Example: DOMAIN=apf.example.com
DOMAIN=
