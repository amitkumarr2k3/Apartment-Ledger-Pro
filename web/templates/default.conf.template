server {
  listen 80;
  server_name _;

  # nginx's own default (1MB) was silently rejecting audited-report PDF
  # uploads (413) before they ever reached the Fastify API, which already
  # allows up to 10MB via @fastify/multipart. Match/exceed that here.
  client_max_body_size 15m;

  # Resolve upstream container names at request time instead of nginx startup,
  # so a slow/unhealthy backend doesn't crash nginx on boot.
  resolver 127.0.0.11 valid=10s ipv6=off;
  # ${API_UPSTREAM} / ${SSR_UPSTREAM} are substituted at container start by the
  # official nginx image's docker-entrypoint.d envsubst step (any *.template
  # file under /etc/nginx/templates/ is rendered into /etc/nginx/conf.d/).
  # Locally (docker-compose) these default to the compose service names;
  # in Azure Container Apps they must be set to each app's internal FQDN,
  # e.g. http://api.internal.<env-default-domain>.
  set $api_upstream "${API_UPSTREAM}";
  set $ssr_upstream "${SSR_UPSTREAM}";

  # Dedicated healthcheck for the web container. Kept intentionally simple
  # (no upstream, no filesystem) so a wedged backend cannot flap web health.
  location = /health {
    access_log off;
    add_header Content-Type application/json;
    return 200 '{"ok":true,"service":"web"}';
  }

  # Fastify API
  location /api/ {
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Everything else — TanStack Start SSR (node)
  location / {
    proxy_pass $ssr_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 60s;
  }
}
