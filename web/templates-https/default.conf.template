# ──────────────────────────────────────────────────────────────────────────────
# HTTPS nginx template — used in production when DOMAIN env var is set.
# This file lives in web/templates-https/ and is mounted OVER the default
# web/templates/ directory by docker-compose.https.yml so that the HTTP-only
# default.conf.template is NOT rendered alongside this one.
#
# Variables substituted at container start by nginx envsubst entrypoint:
#   ${DOMAIN}         — your public domain, e.g. apf.example.com
#   ${API_UPSTREAM}   — defaults to http://api:4000
#   ${SSR_UPSTREAM}   — defaults to http://ssr:3000
# ──────────────────────────────────────────────────────────────────────────────

# ── Port 80: ACME challenge passthrough + permanent redirect to HTTPS ─────────
server {
  listen 80;
  server_name ${DOMAIN};
  client_max_body_size 25m;   # <-- add this line (raises the 1MB default; adjust as needed for your largest expected PDF)

  # Let certbot's webroot plugin write challenge files here during renewal.
  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  # Everything else: hard redirect to HTTPS (301 is cached by browsers).
  location / {
    return 301 https://$host$request_uri;
  }
}

# ── Port 443: TLS termination + reverse proxy ─────────────────────────────────
server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};

  # Let's Encrypt certificate paths (managed by certbot on the host).
  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

  # Modern TLS settings (Mozilla Intermediate compatibility).
  ssl_protocols             TLSv1.2 TLSv1.3;
  ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256;
  ssl_prefer_server_ciphers off;
  ssl_session_cache         shared:SSL:10m;
  ssl_session_timeout       1d;
  ssl_session_tickets       off;

  # Security headers.
  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
  add_header X-Frame-Options            DENY                                           always;
  add_header X-Content-Type-Options     nosniff                                        always;
  add_header Referrer-Policy            "strict-origin-when-cross-origin"              always;

  # Resolve upstream container names at request time (Docker internal DNS).
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $api_upstream "${API_UPSTREAM}";
  set $ssr_upstream "${SSR_UPSTREAM}";

  # Health probe (no upstream dependency).
  location = /health {
    access_log off;
    add_header Content-Type application/json;
    return 200 '{"ok":true,"service":"web"}';
  }

  # Fastify API
  location /api/ {
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host               $host;
    proxy_set_header X-Real-IP          $remote_addr;
    proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto  https;
  }

  # TanStack Start SSR (everything else)
  location / {
    proxy_pass $ssr_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host               $host;
    proxy_set_header X-Real-IP          $remote_addr;
    proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto  https;
    proxy_set_header Upgrade            $http_upgrade;
    proxy_set_header Connection         "upgrade";
    proxy_read_timeout 60s;
  }
}
